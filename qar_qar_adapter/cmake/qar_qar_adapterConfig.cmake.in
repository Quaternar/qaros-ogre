@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# qar_ogre_streaming is a PUBLIC dependency: this package's headers include the
# library's seam and value types, and it brings the vendored QarOS C header on its
# public include path.
find_dependency(qar_ogre_streaming)

include("${CMAKE_CURRENT_LIST_DIR}/qar_qar_adapterTargets.cmake")

check_required_components(qar_qar_adapter)
